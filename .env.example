# Service Host & Port
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Supported values: auto, gemini, openai, groq, heuristic
LLM_PROVIDER=auto

# API Keys (Set at least one for external LLM inference, or leave empty to use heuristic NLP fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Model Identifiers
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Per-request LLM timeout (seconds)
LLM_TIMEOUT_SECONDS=8.0
